<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The shared helper kit (ENH-12): small, pure, contract-free helpers that several features need
    (byte formatting, pause gate, byte comparison, greyscale + perceptual hashing, the undo-able review
    folder). It is NOT part of the plugin contract: the host never references it, and each feature that
    uses it ships its own copy inside its plugin folder (its PluginLoadContext loads that copy), so
    features stay independent. Opt in from a feature's .csproj with <UseKit>true</UseKit>.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DigitalSecretary.Kit</RootNamespace>
    <AssemblyName>DigitalSecretary.Kit</AssemblyName>
  </PropertyGroup>

</Project>
