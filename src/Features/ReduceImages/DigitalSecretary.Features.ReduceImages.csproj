<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>DigitalSecretary.Features.ReduceImages</RootNamespace>
    <AssemblyName>DigitalSecretary.Features.ReduceImages</AssemblyName>
    <!-- Shared helpers (ByteSize, PauseToken, ffmpeg locate/run, ShrinkSwap, SavingsLedger, Verdict) come from the kit. -->
    <UseKit>true</UseKit>
    <!-- No NuGet dependencies: GDI+ for JPEG / PNG; ffmpeg (optional, never shipped) only for WebP / AVIF. -->
  </PropertyGroup>

</Project>
