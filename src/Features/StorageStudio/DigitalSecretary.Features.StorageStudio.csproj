<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>DigitalSecretary.Features.StorageStudio</RootNamespace>
    <AssemblyName>DigitalSecretary.Features.StorageStudio</AssemblyName>
    <!-- Shared helpers (ByteSize, PauseToken, ...) come from the kit - see src/Features/Directory.Build.props. -->
    <UseKit>true</UseKit>
    <!-- No NuGet dependencies: the feature uses only the framework (file I/O, GZip, JSON, WinForms/GDI+). -->
  </PropertyGroup>

</Project>
