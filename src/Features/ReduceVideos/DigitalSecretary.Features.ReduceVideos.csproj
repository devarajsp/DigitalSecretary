<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>DigitalSecretary.Features.ReduceVideos</RootNamespace>
    <AssemblyName>DigitalSecretary.Features.ReduceVideos</AssemblyName>
    <!-- Shared helpers (ByteSize, PauseToken, Media Foundation interop, ffmpeg locate/run, ShrinkSwap, SavingsLedger) come from the kit. -->
    <UseKit>true</UseKit>
    <!-- No NuGet dependencies. ffmpeg is optional and never shipped: the user installs it (winget) and the feature finds it. -->
  </PropertyGroup>

</Project>
