<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>DigitalSecretary.Features.SimilarVideos</RootNamespace>
    <AssemblyName>DigitalSecretary.Features.SimilarVideos</AssemblyName>
    <!-- Shared helpers (ByteSize, PauseToken, ImageHasher, ReviewFolder, ...) come from the kit - see src/Features/Directory.Build.props. -->
    <UseKit>true</UseKit>
    <!-- No NuGet dependencies: framework only (Windows Media Foundation via COM, GDI+, GZip, JSON, WinForms). -->
  </PropertyGroup>

  <ItemGroup>
    <!-- The unit tests drive the Media Foundation interop directly to make tiny test videos at run time. -->
    <InternalsVisibleTo Include="DigitalSecretary.UnitTests" />
  </ItemGroup>

</Project>
